# 复制为 .env 并按需填写。未配置 LLM_API_KEY 时系统走离线启发式回退。

# LLM（OpenAI 兼容协议）
# 示例：OpenAI / Claude 兼容网关 / 通义千问 DashScope 兼容模式 / DeepSeek / GLM
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
# 单次请求超时（秒）。防止个别请求挂死阻塞并发 worker。
LLM_TIMEOUT=90

# 人工标注语料 CSV（data_id,content,comment）
QC_CASES_PATH=data/sample_cases.csv

# 检索召回条数
QC_RETRIEVE_TOP_K=3

# agent loop 最大工具调用回合
QC_MAX_TOOL_TURNS=6

# 质检模式：false=快速检索增强单轮（默认，省时省钱，适合大批量）；true=完整 agentic tool loop（更慢更准）
QC_USE_TOOLS=false

# 超长转写截断字符数（保留头尾，控制 token），0=不截断
QC_MAX_CONTENT_CHARS=6000

# LLM 调用失败重试次数与退避基数（秒）
QC_LLM_MAX_RETRIES=3
QC_LLM_RETRY_BACKOFF=2.0

# 批量评估并发数（与 config.py 默认值保持一致）
QC_BATCH_CONCURRENCY=4

# 两阶段策略：快速模式置信度低于该值则自动升级到 tool loop 复核，0=关闭
QC_ESCALATE_BELOW_CONFIDENCE=0.0

# 结果缓存路径（按内容哈希，降本避免重复/重跑 LLM 调用），空=禁用
QC_CACHE_PATH=

# ---- 不确定性信号与质量门控（见 README 第 11 节）----
# 总开关：证据校验失败/启发式涉诈冲突/JSON修复兜底时自动升级 tool loop 复核
QC_ESCALATE_ON_SIGNALS=true
# 软信号触发的选择性自一致性采样次数（含首答），1=关闭
QC_SELF_CONSISTENCY_K=2
# 自一致性采样温度（需 >0 才有多样性）
QC_SC_TEMPERATURE=1.0
# kNN 判例冲突信号的最低相似度门槛
QC_KNN_SIGNAL_MIN_SIM=0.25
# 自报置信度低于该值视为软信号（触发采样复核而非直接升级）
QC_SOFT_CONFIDENCE_BELOW=0.9
# 判正常但 top-1 路由为涉诈技能且分数≥该值时视为软信号
QC_ROUTE_FRAUD_SIGNAL_MIN=0.25

# ---- 场景技能库（渐进式披露）----
QC_USE_SKILLS=true
QC_SKILLS_DIR=knowledge/skills
# 随待检文本注入的技能数
QC_SKILLS_TOP_K=3
# 随待检文本注入的相关消歧规则条数（system prompt 仅常驻标题索引）
QC_DISAMBIG_TOP_K=6
