# 复制为 .env 并按需填写。未配置 LLM_API_KEY 时系统走离线启发式回退。

# LLM（OpenAI 兼容协议）
# 示例：OpenAI / Claude 兼容网关 / 通义千问 DashScope 兼容模式 / DeepSeek / GLM
LLM_API_KEY=sk-4f4ed265b9144b9f92b07f1bdadf243a
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
